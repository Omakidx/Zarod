# Copy to .env.local, chmod 600 it, and fill it in. Never commit or share .env.local.

# From @BotFather
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID (ask @userinfobot). The bot ignores everyone else.
OWNER_TELEGRAM_ID=
# Generate with: ./dc run --rm --no-deps bot python -m followbot keygen
# Losing it means re-connecting your accounts; leaking it plus the DB exposes your sessions.
ENCRYPTION_KEY=

# Surfshark dashboard -> VPN -> Manual setup -> Router -> WireGuard -> generate key pair -> private key
SURFSHARK_WG_PRIVATE_KEY=
# The one Surfshark server to pin (keeps the exit IP stable), e.g. us-nyc.prod.surfshark.com
# List: docker run --rm qmcgaw/gluetun:v3.40.0 format-servers -surfshark
VPN_HOSTNAME=

# Paste the User-Agent of the browser you export cookies from (search "what is my user agent").
BROWSER_USER_AGENT=
# Optional: when one platform's cookies come from a different browser, that browser's user agent.
X_USER_AGENT=
INSTAGRAM_USER_AGENT=

# Cookie exports (JSON from your extension), imported by the bot at startup.
# File names inside ./secrets/ (chmod 600). Leave empty to use /connect in Telegram instead.
X_COOKIES_FILE=
INSTAGRAM_COOKIES_FILE=

# Rate limits (defaults shown)
WINDOW_LIMIT=13
WINDOW_SECONDS=600
GAP_MIN_SECONDS=35
GAP_MAX_SECONDS=65
DAILY_LIMIT_X=200
DAILY_LIMIT_INSTAGRAM=100
